{
  "name": "gnozian-remastered",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/precache.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "prebuild": "node scripts/generate2dAssets.mjs && node scripts/materialize3d.mjs",
    "predev": "node scripts/generate2dAssets.mjs && node scripts/materialize3d.mjs",
    "pretest": "node scripts/generate2dAssets.mjs",
    "assets:3d": "node scripts/materialize3d.mjs",
    "assets:3d:check": "node scripts/materialize3d.mjs --verify"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "discord-rpc": "^4.0.1",
    "framer-motion": "^12.38.0",
    "lz-string": "^1.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0",
    "three": "^0.170.0",
    "zod": "^4.1.12",
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "typescript": "5.9.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4",
    "tailwindcss": "4.1.17"
  }
}
